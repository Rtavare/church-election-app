# QR voting — live multi-phone mode (optional)
# Copy to .env and fill in after running supabase/schema.sql in your Supabase project.
# Without these, the app runs in LOCAL DEMO mode: QR sessions sync only
# across tabs/windows of the same browser, for testing the flow.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public address where the web app is hosted — this is what the QR code encodes.
VITE_PUBLIC_BASE_URL=
